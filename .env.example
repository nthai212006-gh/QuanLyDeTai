# ========================================================
# FIT-THESIS HCMUTE - CẤU HÌNH MÔI TRƯỜNG CỤC BỘ (LOCAL ENV)
# ========================================================
# Tạo một bản sao của file này đặt tên là '.env' tại thư mục gốc dự án
# và điền API Key mới của bạn vào bên dưới.
# File '.env' đã được cấu hình trong .gitignore, không bị đẩy lên Git.

GEMINI_API_KEY=your_new_gemini_api_key_here
